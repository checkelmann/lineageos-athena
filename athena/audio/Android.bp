cc_library_shared {
    name: "audio.primary.athena",
    vendor: true,
    relative_install_path: "hw",
    compile_multilib: "32",
    srcs: ["primary_capture_compat.cpp"],
    header_libs: ["libhardware_headers"],
    shared_libs: ["libcutils", "libdl", "liblog"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

cc_test {
    name: "athena_capture_compat_test",
    vendor: true,
    compile_multilib: "32",
    srcs: ["primary_capture_compat_test.cpp"],
    header_libs: ["libhardware_headers"],
    shared_libs: ["libcutils", "libdl", "liblog"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

cc_binary {
    name: "fireos.hardware.audio.service",

    init_rc: ["fireos.hardware.audio.service.rc"],
    relative_install_path: "hw",
    compile_multilib: "32",
    vendor: true,

    srcs: ["service.cpp"],

    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],

    shared_libs: [
        "libcutils",
        "libbinder",
        "libbinder_ndk",
        "libhidlbase",
        "liblog",
        "libutils",
        "libhardware",
    ],
}
